# Copy to backend/.env and fill in.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://school_app:CHANGE_ME@localhost:5432/school_assessment
TEST_DATABASE_URL=postgresql://school_app:CHANGE_ME@localhost:5432/school_assessment_test
# Public URL of the web app, used in invitation and reset links.
APP_BASE_URL=http://localhost:5173
# Comma-separated origins allowed to call the API with credentials (dev only; production serves same-origin).
CORS_ORIGINS=http://localhost:5173
# Production only: path to the built web app (frontend/dist), served from the same origin.
WEB_DIST_DIR=

# Email: "console" logs links locally, "emailjs" sends through EmailJS REST.
EMAIL_PROVIDER=console
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_INVITATION=
EMAILJS_TEMPLATE_RESET=
EMAILJS_MONTHLY_QUOTA=200
EMAIL_FROM_NAME=School Teaching Monitor
EMAIL_REPLY_TO=
