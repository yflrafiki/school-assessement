{
  "name": "@school/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=source prisma/seed.ts",
    "create-headmaster": "tsx --conditions=source src/cli/create-headmaster.ts",
    "postinstall": "prisma generate",
    "extract-scheme": "tsx --conditions=source src/cli/extract-scheme.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@school/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
